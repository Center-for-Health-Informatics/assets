# Rename to .env in the deployment folder. These are interpolated by Docker
# Compose itself (the ${...} references in compose.yaml).
#
# Not a free choice: chi-hermes' `location /assets/` hard-codes this port in its
# proxy_pass (`proxy_pass http://cetus-priv:27738/;`). Changing it here means
# changing it there too, in the same deploy.
HTTP_PORT=27738
# Address to publish HTTP_PORT on. Must be reachable only by chi-hermes — on
# chi-cetus that is 192.168.80.1, the private VM network. No default on purpose:
# an unset value aborts the deploy rather than listening everywhere. See README.
BIND_ADDRESS=<private address of this host>
TZ=<IANA tz entry location>
